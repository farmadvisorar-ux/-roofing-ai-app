// Prisma schema for the roofing/shed AR + CRM app.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum LeadStage {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum LeadSource {
  CONFIGURATOR
  AR_VIEWER
  MANUAL
  PHONE
  REFERRAL
  CANVASSING
}

enum EnrichmentStatus {
  PENDING
  ENRICHED
  PARTIAL
  FAILED
}

enum ScoreBand {
  HOT
  WARM
  COOL
  COLD
  /// Too little is known to call it either way — not a verdict, an absence of one.
  UNRATED
}

/// What happened to a property. Every change to a record a rep will act on is
/// logged, so "why is this a 84?" always has an answer.
enum StormKind {
  HAIL
  WIND
}

enum PropertyEventKind {
  CREATED
  SWEPT
  ENRICHED
  SCORED
  MEASURED
  CONVERTED
  UPDATED
}

enum ContractType {
  CASH
  FINANCE
  RENT_TO_OWN
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  VOID
}

enum RoofStyle {
  GABLE
  LEAN_TO
  GAMBREL
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

model Lead {
  id             String     @id @default(cuid())
  contactId      String
  contact        Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage          LeadStage  @default(NEW)
  source         LeadSource @default(CONFIGURATOR)
  estimatedValue Float      @default(0)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  shedConfig ShedConfig?
  contracts  Contract[]
  property   Property?
}

model ShedConfig {
  id          String    @id @default(cuid())
  leadId      String?   @unique
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  widthFt     Float
  lengthFt    Float
  wallHeightFt Float
  roofStyle   RoofStyle @default(GABLE)
  roofPitch   Float     @default(4)
  sidingColor String    @default("#c9c2b4")
  trimColor   String    @default("#ffffff")
  roofColor   String    @default("#3a3f44")
  doorCount   Int       @default(1)
  doorWidthFt Float     @default(3)
  windowCount Int       @default(2)
  price       Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contract {
  id             String         @id @default(cuid())
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           ContractType
  status         ContractStatus @default(DRAFT)
  totalPrice     Float
  downPayment    Float          @default(0)
  apr            Float          @default(0)
  termMonths     Int            @default(0)
  monthlyPayment Float          @default(0)
  signerName     String?
  signatureData  String?
  signedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

/// A roof we might sell to, pinned on the canvassing map. Created from a map tap
/// (often before we know anything about it), then filled in by the enrichment
/// pipeline in src/lib/propertyEnrichment.ts from open data sources.
model Property {
  id  String @id @default(cuid())
  lat Float
  lng Float

  // Reverse-geocoded address (OpenStreetMap / Nominatim).
  address String?
  city    String?
  state   String?
  zip     String?

  // Ownership, from a county assessor / parcel open-data endpoint.
  ownerName String?
  parcelId  String?

  // Building facts (OpenStreetMap buildings, via Overpass).
  osmRef         String? @unique
  footprintSqFt  Float?
  buildingLevels Int?
  roofShape      String?
  roofMaterial   String?
  yearBuilt      Int?

  // Roof estimate derived from the facts above (src/lib/roofing.ts).
  roofSqFt     Float?
  roofSquares  Float?
  estimateLow  Float?
  estimateHigh Float?

  // --- Buying signals -----------------------------------------------------
  // Assessor record: a house that changed hands recently is a far warmer lead.
  assessedValue Float?
  lastSaleDate  DateTime?
  lastSalePrice Float?

  // Permit record. A recent roofing permit is the strongest negative signal
  // there is — that roof was just done, so don't knock.
  lastPermitDate DateTime?
  lastPermitType String?
  roofPermitDate DateTime?

  // Observed hail near this address, from the locally imported NOAA storm
  // reports. The single most predictive signal in roofing: a 2" hail event a
  // year ago means most roofs on that street have a claim on them.
  hailEventsNearby   Int?
  maxHailInches      Float?
  lastHailDate       DateTime?
  hailWindowYears    Int?
  hailSearchRadiusMi Float?

  // Wind exposure from the Open-Meteo archive. A weaker, complementary signal:
  // reanalysis captures sustained wind well but does not resolve convective
  // storms, so it ranks windy coastlines above hail country on its own.
  stormWindowYears Int?
  severeStormDays  Int?
  peakGustMph      Float?

  // Explainable score, 0-100. `scoreComponents` holds the per-signal breakdown
  // as JSON and `scoreConfidence` how much of the model had data to work with.
  leadScore       Int?
  leadScoreBand   ScoreBand?
  scoreConfidence Float?
  scoreComponents String?
  scoredAt        DateTime?

  enrichmentStatus  EnrichmentStatus @default(PENDING)
  enrichmentSources String? // comma-separated provider ids that contributed
  enrichmentError   String?
  enrichedAt        DateTime?

  notes String?

  // Set once the property has been worked into the pipeline. Deleting the lead
  // keeps the pin on the map — the roof still exists, it just isn't a lead now.
  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PropertyEvent[]

  @@index([lat, lng])
  @@index([leadScore])
  @@index([enrichmentStatus])
}

/// Observed severe-weather reports, imported from NOAA SPC (public domain) by
/// `npm run import:storms`. Held locally so scoring a property costs a indexed
/// query rather than a third-party API call per address.
model StormEvent {
  id         String    @id @default(cuid())
  kind       StormKind
  occurredAt DateTime
  lat        Float
  lng        Float
  /// Hail diameter in inches, or gust speed in knots for wind reports.
  magnitude  Float?
  state      String?
  /// Stable identity from the source file, so re-importing cannot duplicate.
  sourceKey  String    @unique

  @@index([occurredAt])
  @@index([lat, lng])
}

/// Append-only trail of what happened to a property and what changed it.
model PropertyEvent {
  id         String            @id @default(cuid())
  propertyId String
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind       PropertyEventKind
  summary    String
  /// JSON detail — the provider results or field changes behind this event.
  detail     String?
  /// Who or what caused it: a provider id, "sweep", or a user identifier.
  actor      String?
  createdAt  DateTime          @default(now())

  @@index([propertyId, createdAt])
}
